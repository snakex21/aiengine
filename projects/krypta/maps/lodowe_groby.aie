PLACE light pulse lodowy_blask 10.5 1 2.5 radius=4 level=0.5 speed=0.3 min=0.4
PLACE light flicker pochodnia_g 17.5 0.7 2.5 radius=2.5 level=0.8 speed=9 min=0.2
PLACE light pulse taras 19.5 0.7 7.5 radius=3 level=0.6 speed=0.5 min=0.3
PLACE light pulse portal_blask 9.5 0 13.5 radius=2.5 level=0.9 speed=0.8 min=0.4

# Typy przeciwników (wartości domyślne dla PLACE enemy i spawnEnemy)
PLACE enemy_type straznik 0 0 0 hp=50 speed=0.9 damage=10 sight=5 behavior=chase
PLACE enemy_type pajak 0 0 0 hp=20 speed=2.2 damage=6 sight=6 behavior=wander atlas=assets/sprites/pajak.png scale=0.55 z=0.22 range=0.7 attack_rate=0.7

PLACE item crystal k1 12.5 0 1.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k2 16.5 0 4.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k3 14.5 0 8.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k4 19.5 0 13.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k5 1.5 0 13.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item klucz_czerwony kc 6.5 0 6.5 give=klucz_czerwony bob=0.1 scale=0.4
PLACE item klucz_niebieski kn 19.5 0 1.5 give=klucz_niebieski bob=0.1 scale=0.4
PLACE item relikwia r1 10.5 0 11.5 give=relikwia bob=0.1 scale=0.4
PLACE item potion m1 20.5 0 6.5 scale=0.35
PLACE item potion m2 5.5 0 13.5 scale=0.35
PLACE zone acid kw1 8.5 0 3.5 radius=0.45 sprite=acid scale=0.7
PLACE zone acid kw2 16.5 0 12.5 radius=0.45 sprite=acid scale=0.7
PLACE door czerwone 14 0 3 key=klucz_czerwony
PLACE door niebieskie 4 0 10 key=klucz_niebieski
PLACE door nisza 10 0 10 secret=yes
PLACE door brama 12 0 14
PLACE enemy pajak p1 3.5 0 8.5
PLACE enemy pajak p2 16.5 0 7.5
PLACE enemy pajak p3 14.5 0 13.5
PLACE enemy straznik s1 19.5 0 3.5 behavior=ambush
PLACE enemy straznik s2 5.5 0 11.5 behavior=guard
PLACE zone exit portal 9.5 0 13.5 radius=0.6 sprite=portal scale=0.9

SOUND ding
  WAVEFORM sine
  FREQUENCY 1320
  DECAY 0.25
  VOLUME 0.5

SOUND gate
  WAVEFORM square
  FREQUENCY 110
  DECAY 0.9
  VOLUME 0.4

SOUND sizzle
  TYPE noise
  FREQUENCY 400
  DECAY 0.15
  VOLUME 0.3

SOUND heal
  WAVEFORM triangle
  FREQUENCY 660
  DECAY 0.4
  VOLUME 0.5

SOUND klucz
  WAVEFORM sine
  FREQUENCY 880
  DECAY 0.35
  VOLUME 0.45

SOUND sekret
  WAVEFORM triangle
  FREQUENCY 520
  DECAY 0.8
  VOLUME 0.45

SOUND zamek
  WAVEFORM square
  FREQUENCY 160
  DECAY 0.12
  VOLUME 0.3

SOUND krypta_drone
  WAVEFORM triangle
  FREQUENCY 55
  DECAY 3.5
  VOLUME 0.25

TRIGGER brama_otwarta
  CONDITION var_at_least krysztaly 5
  ACTION unlock_door brama
  ACTION play_sound gate
  ACTION show_message "Brama otwarta! Biegnij do portalu"
