# maps/trening.aie — Trening: krótki poziom na rozgrzewkę.
# 3 kryształy, jedna kałuża kwasu, jeden powolny strażnik, brama i portal.

MAP trening
PLAYER_ANGLE 0
PLAYER_HP 100
FLOOR_COLOR #1A2018
CEILING_COLOR #0A0E0A
VAR_TIME_LIMIT 120
VAR_MUSIC krypta_drone

GRID
W W W W W W W W W W
W P . . . . W . . W
W . . . . . W . . W
W . . . S . D . . W
W . . . . . W . . W
W . . . . . W . . W
W W W W W W W W W W

PLACE item crystal t1 4.5 0 1.5 bob=0.15
PLACE item crystal t2 1.5 0 5.5 bob=0.15
PLACE item crystal t3 5.5 0 5.5 bob=0.15
PLACE zone acid tkwas 3.5 0 3.5 radius=0.45 sprite=acid scale=0.7
PLACE enemy straznik ts1 2.5 0 4.5 hp=25 speed=0.6 damage=5 sight=3
PLACE door brama 6 0 3
PLACE zone exit portal 8.5 0 1.5 radius=0.6 sprite=portal scale=0.9

SOUND ding
  WAVEFORM sine
  FREQUENCY 1320
  DECAY 0.25
  VOLUME 0.5

SOUND gate
  WAVEFORM square
  FREQUENCY 110
  DECAY 0.9
  VOLUME 0.4

SOUND sizzle
  TYPE noise
  FREQUENCY 400
  DECAY 0.15
  VOLUME 0.3

SOUND heal
  WAVEFORM triangle
  FREQUENCY 660
  DECAY 0.4
  VOLUME 0.5

SOUND krypta_drone
  WAVEFORM triangle
  FREQUENCY 55
  DECAY 3.5
  VOLUME 0.25

TRIGGER brama_otwarta
  CONDITION var_at_least krysztaly 3
  ACTION unlock_door brama
  ACTION play_sound gate
  ACTION show_message "Brama otwarta! Biegnij do portalu"
