# maps/sanktuarium.aie — Poziom 5: Ośmiokątne Sanktuarium (mapa SEKTOROWA)
# Pierwsza mapa z sektorów zamiast siatki: ściany pod dowolnym kątem,
# każda komnata ma własną wysokość podłogi, sufitu i światło.
#
# SECTOR <id> floor= ceil= light= wall= step= : x z x z ...  (punkty obrysu)
# Krawędź wspólna dwóch sektorów to przejście, pozostałe to ściany.
# 1 jednostka = 1 kratka mapy GRID = wysokość zwykłej ściany.

MAP sanktuarium
PLAYER_START 12 20
PLAYER_ANGLE -90
PLAYER_HP 100
FLOOR_COLOR #1E1A24
CEILING_COLOR #0C0B14
FLOOR_TEX floor
CEILING_TEX ceiling
LIGHT_AMBIENT 0.55
FOG yes color=#0A0910 density=0.07
VAR_TIME_LIMIT 240
VAR_MUSIC krypta_drone
INTRO Ośmiokątne sanktuarium - ściany biegną tu pod dowolnym kątem.|Cztery kryształy: na ołtarzu, na wschodnim balkonie, w zatopionej sadzawce i przy wejściu.|Portal czeka w północnej niszy - jej wrota otworzą się po zebraniu kryształów.
OUTRO Sanktuarium zostaje w tyle. Przed tobą już tylko serce krypty.

# Przedsionek (start), sześciokątny
SECTOR przedsionek floor=0 ceil=1.5 light=0.5 wall=W : 10 17 14 17 15 19 14 21 10 21 9 19

# Wielka ośmiokątna sala: 8 trapezów wokół ołtarza (wysokie sklepienie)
SECTOR sala_n floor=0 ceil=3 light=0.6 wall=W : 10 7 14 7 13 10 11 10
SECTOR sala_ne floor=0 ceil=3 light=0.55 wall=W : 14 7 17 10 14 11 13 10
SECTOR sala_e floor=0 ceil=3 light=0.6 wall=W : 17 10 17 14 14 13 14 11
SECTOR sala_se floor=0 ceil=3 light=0.55 wall=W : 17 14 14 17 13 14 14 13
SECTOR sala_s floor=0 ceil=3 light=0.6 wall=W : 14 17 10 17 11 14 13 14
SECTOR sala_sw floor=0 ceil=3 light=0.55 wall=W : 10 17 7 14 10 13 11 14
SECTOR sala_w floor=0 ceil=3 light=0.6 wall=W : 7 14 7 10 10 11 10 13
SECTOR sala_nw floor=0 ceil=3 light=0.55 wall=W : 7 10 10 7 11 10 10 11

# Ołtarz: podwyższony ośmiokąt pod obniżonym sufitem
SECTOR oltarz floor=0.25 ceil=2.25 light=0.9 step=M : 11 10 13 10 14 11 14 13 13 14 11 14 10 13 10 11

# Wschód: schody w górę na balkon o skośnych ścianach
SECTOR schody1 floor=0.25 ceil=2.5 light=0.6 wall=S step=S : 17 10 18 10 18 14 17 14
SECTOR schody2 floor=0.5 ceil=2.5 light=0.65 wall=S step=S : 18 10 19 10 19 14 18 14
SECTOR schody3 floor=0.75 ceil=2.5 light=0.7 wall=S step=S : 19 10 20 10 20 14 19 14
SECTOR balkon floor=1 ceil=2.5 light=0.8 wall=M step=S : 20 10 23 8 26 10 26 14 23 16 20 14

# Zachód: rampa w dół do zatopionej sadzawki (ciemno)
SECTOR rampa1 floor=-0.25 ceil=1.5 light=0.45 wall=S step=S : 6 10 7 10 7 14 6 14
SECTOR rampa2 floor=-0.5 ceil=1.25 light=0.35 wall=S step=S : 5 10 6 10 6 14 5 14
SECTOR sadzawka floor=-0.75 ceil=1 light=0.25 wall=S step=S floor_tex=woda : 5 10 5 14 2 16 1 12 2 8

# Północ: nisza z portalem
SECTOR wrota floor=0.25 ceil=1.75 light=0.65 wall=M step=D tag=wrota : 10 7 14 7 14 6 10 6
SECTOR nisza floor=0.25 ceil=1.75 light=0.7 wall=M step=M : 10 6 10 5 11 3 13 3 14 5 14 6
MOVER door wrota locked=yes wait=0 speed=1

# Kryształy (4)
PLACE item crystal k1 12 0 12 bob=0.15 glow=0.4 glow_radius=2
PLACE item crystal k2 24 0 12 bob=0.15 glow=0.4 glow_radius=2
PLACE item crystal k3 2.6 0 12 bob=0.15 glow=0.5 glow_radius=2
PLACE item crystal k4 14 0 19.5 bob=0.15 glow=0.4 glow_radius=2
PLACE item potion m1 3.5 0 9.6 scale=0.35
PLACE item potion m2 25 0 13 scale=0.35

# Strażnicy i pająk
PLACE enemy_type straznik 0 0 0 hp=50 speed=0.9 damage=10 sight=5 behavior=chase
PLACE enemy_type pajak 0 0 0 hp=20 speed=2.2 damage=6 sight=6 behavior=wander atlas=assets/sprites/pajak.png scale=0.55 z=0.22 range=0.7 attack_rate=0.7
PLACE enemy straznik s1 24 0 11 behavior=guard
PLACE enemy straznik s2 15.5 0 9.5 behavior=ambush
PLACE enemy pajak p1 3 0 13

# Portal
PLACE zone exit portal 12 0 4.4 radius=0.6 sprite=portal scale=0.9

# Światła
PLACE light pulse oltarz_blask 12 1 12 radius=4 level=0.5 speed=0.4 min=0.3
PLACE light flicker pochodnia_p 9.5 0.7 19 radius=3 level=0.5 speed=9 min=0.3
PLACE light pulse sadzawka_blask 3 0 12 radius=3 level=0.35 speed=0.25 min=0.2
PLACE light pulse portal_blask 12 0 4.4 radius=3 level=0.8 speed=0.8 min=0.4

SOUND ding
  WAVEFORM sine
  FREQUENCY 1320
  DECAY 0.25
  VOLUME 0.5

SOUND krypta_drone
  WAVEFORM triangle
  FREQUENCY 55
  DECAY 3.5
  VOLUME 0.25

SOUND heal
  WAVEFORM triangle
  FREQUENCY 660
  DECAY 0.4
  VOLUME 0.5


TRIGGER wrota_otwarte
  CONDITION var_at_least krysztaly 4
  ACTION unlock_door wrota
  ACTION show_message "Wrota niszy otwarte! Biegnij do portalu"
