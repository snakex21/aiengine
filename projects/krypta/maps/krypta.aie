# maps/krypta.aie — Poziom 2: Kryształowa Krypta
# Zbierz 6 kryształów, omijaj kałuże kwasu i strażników,
# a potem uciekaj portalem za runiczną bramą (D).
#
# GRID: W = mur krypty, S = omszały kamień, M = brązowa ściana z runą,
#       D = brama, P = start gracza, . = podłoga
# PLACE <rodzaj> <typ> <id> <x> <wysokosc> <z>   (x = kolumna, z = wiersz)

MAP krypta
PLAYER_ANGLE 15
PLAYER_HP 100
FLOOR_COLOR #1E1A24
CEILING_COLOR #0C0B14
HEIGHT_STEP 0.125
LIGHT_AMBIENT 0.4
FOG yes color=#0C0B14 density=0.1
VAR_TIME_LIMIT 180
VAR_MUSIC krypta_drone
INTRO Sześć kryształów, kwas i strażnicy.|Runiczna brama otworzy się dopiero, gdy zbierzesz wszystkie kryształy.
OUTRO Krypta zostaje w tyle, ale chłód bije z dołu - przed tobą Lodowe Groby.

GRID
W W W W W W W W W W W W W W W W
W . . . . W . . . . . . W . . W
W . P . . W . . . . . . W . . W
W . . . . . . . S S . . M . . W
W . . . . W . . S S . . D . . W
W W . W W W . . . . . . M . . W
W . . . . W W W . W W W W W W W
W . . . . . . W . W . . . . . W
W . S . . . . W . . . . S . . W
W . S . . . . W . W . . S . . W
W . . . . . . . . W . . . . . W
W W W W . W W W . W W W W . . W
W . . . . . . . . . . . . . . W
W W W W W W W W W W W W W W W W

# Wysokosci i swiatlo: zapadnieta sala z krysztalami pod wysokim sklepieniem,
# podest z portalem, polka z krysztalem, niska ciemna komnata i obnizony korytarz.
FLOOR_GRID
. . . . . . . . . . . . . . . .
. . . . . . b b b b b b . 2 2 .
. . . . . . b b b b b b . 2 2 .
. . . . . a b b b b b b . 2 2 .
. . . . . . b b b b b b b . . .
. . . . . . b b b b b b . . . .
. . . . . . . . a . . . . . . .
. 2 . . . . . . . . . . . . . .
. 2 . . . . . . . . . . . . . .
. 2 . . . . . . . . . . . . . .
. 2 . . . . . . . . . . . . . .
. . . . a . . . . . . . . a a .
. b b b b b b b b b b b b b b .
. . . . . . . . . . . . . . . .

CEILING_GRID
. . . . . . . . . . . . . . . .
. . . . . . G G G G G G . . . .
. . . . . . G G G G G G . . . .
. . . . . . G G G G G G . . . .
. . . . . . G G G G G G . . . .
. . . . . . G G G G G G . . . .
. . . . . . . . . . . . . . . .
. . . . . . . . . . 6 6 6 6 6 .
. . . . . . . . . . 6 6 6 6 6 .
. . . . . . . . . . 6 6 6 6 6 .
. . . . . . . . . . 6 6 6 6 6 .
. . . . . . . . . . . . . . . .
. 6 6 6 6 6 6 6 6 6 6 6 6 6 6 .
. . . . . . . . . . . . . . . .

LIGHT_GRID
. . . . . . . . . . . . . . . .
. 6 6 6 6 . 5 5 5 5 5 5 . 7 7 .
. 6 6 6 6 . 5 5 5 5 5 5 . 7 7 .
. 6 6 6 6 . 5 5 5 5 5 5 . 7 7 .
. 6 6 6 6 . 5 5 5 5 5 5 . 7 7 .
. . . . . . 5 5 5 5 5 5 . 7 7 .
. . . . . . . . . . . . . . . .
. . . . . . . . . . 2 2 2 2 2 .
. . . . . . . . . . 2 2 2 2 2 .
. . . . . . . . . . 2 2 2 2 2 .
. . . . . . . . . . 2 2 2 2 2 .
. . . . . . . . . . . . . . . .
. 3 3 3 3 3 3 3 3 3 3 3 3 3 3 .
. . . . . . . . . . . . . . . .

PLACE light flicker pochodnia_a 1.5 0.7 1.5 radius=3 level=0.6 speed=8 min=0.3
PLACE light flicker pochodnia_c 6.5 0.7 7.5 radius=3 level=0.7 speed=11 min=0.2
PLACE light flicker pochodnia_d 7.5 0.7 12.5 radius=3 level=0.6 speed=9 min=0.25
PLACE light pulse portal_blask 13.5 0 2.5 radius=3 level=0.9 speed=0.7 min=0.4

# Krysztaly (6) — bob= unosi sprite nad podloga
PLACE item crystal k1 10.5 0 1.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k2 6.5 0 4.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k3 1.5 0 9.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k4 5.5 0 7.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k5 13.5 0 9.5 bob=0.15 glow=0.35 glow_radius=1.5
PLACE item crystal k6 1.5 0 12.5 bob=0.15 glow=0.35 glow_radius=1.5

# Mikstury leczace
PLACE item potion m1 14.5 0 12.5 scale=0.35
PLACE item potion m2 3.5 0 1.5 scale=0.35

# Kaluze kwasu (strefy zadajace obrazenia — obsluga w Lua)
PLACE zone acid kwas1 7.5 0 2.5 radius=0.45 sprite=acid scale=0.7
PLACE zone acid kwas2 3.5 0 9.5 radius=0.45 sprite=acid scale=0.7
PLACE zone acid kwas3 11.5 0 9.5 radius=0.45 sprite=acid scale=0.7
PLACE zone acid kwas4 10.5 0 12.5 radius=0.45 sprite=acid scale=0.7

# Straznicy krypty
PLACE enemy straznik s1 10.5 0 4.5 hp=50 speed=0.9 damage=10 sight=5
PLACE enemy straznik s2 13.5 0 7.5 hp=50 speed=0.9 damage=10 sight=5
PLACE enemy straznik s3 5.5 0 9.5 hp=50 speed=0.9 damage=10 sight=5

# Brama do komnaty z portalem i sam portal
PLACE door brama 12 0 4
PLACE zone exit portal 13.5 0 2.5 radius=0.6 sprite=portal scale=0.9

# Proceduralne dzwieki
SOUND ding
  WAVEFORM sine
  FREQUENCY 1320
  DECAY 0.25
  VOLUME 0.5

SOUND gate
  WAVEFORM square
  FREQUENCY 110
  DECAY 0.9
  VOLUME 0.4

SOUND sizzle
  TYPE noise
  FREQUENCY 400
  DECAY 0.15
  VOLUME 0.3

SOUND krypta_drone
  WAVEFORM triangle
  FREQUENCY 55
  DECAY 3.5
  VOLUME 0.25

SOUND heal
  WAVEFORM triangle
  FREQUENCY 660
  DECAY 0.4
  VOLUME 0.5

# Triggery: brama otwiera sie, gdy skrypt doliczy 6 krysztalow
TRIGGER brama_otwarta
  CONDITION var_at_least krysztaly 6
  ACTION unlock_door brama
  ACTION play_sound gate
  ACTION show_message "Brama otwarta! Biegnij do portalu"

TRIGGER pierwszy_kwas
  CONDITION player_enters kwas1
  ACTION show_message "Kwas parzy! Omijaj zielone kałuże"
